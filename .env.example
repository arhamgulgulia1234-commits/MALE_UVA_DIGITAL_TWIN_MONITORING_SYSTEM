# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
SIM_TICK_HZ=10

# Demo-safety fallback: serve the Phase 1 scripted generator instead of the physics
# simulation. Same WebSocket contract, no physics. Leave false for normal operation.
USE_MOCK=false

# Phase 3 — persistence
DATABASE_URL=sqlite:///./data/telemetry.db

# Auth — real accounts + JWT (app/auth/). See docs/deployment-roadmap.md for the
# seeded demo credentials and what a real deployment must override.
JWT_SECRET=vayudrishti-dev-insecure-change-me
JWT_EXPIRES_MINUTES=60

# true = fault-injection endpoints work for administrators (training/demo posture).
# false = disabled outright for every role — see app/auth/deps.py::require_demo_mode.
DEMO_MODE=true

# Frontend
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry
NEXT_PUBLIC_API_URL=http://localhost:8000
